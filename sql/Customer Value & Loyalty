-- Gender-wise Analysis

SELECT
    gender,
    ROUND(AVG(previous_purchases), 2) AS avg_previous_purchases
FROM customer_data
GROUP BY gender
ORDER BY avg_previous_purchases DESC;

-- Insight:
-- • Male customers average 25.71 previous purchases.
-- • Female customers average 24.60 previous purchases.


-- ============================================================
-- Question 4: Do subscribed customers make more repeat purchases
-- than non-subscribed customers?
-- ============================================================

SELECT
    subscription_status,
    ROUND(AVG(previous_purchases), 2) AS avg_previous_purchases
FROM customer_data
GROUP BY subscription_status
ORDER BY avg_previous_purchases DESC;

-- Insight:
-- • Subscribed customers average 26.08 previous purchases.
-- • Non-subscribed customers average 25.08 previous purchases.
-- • Subscribers show slightly higher repeat purchasing behavior.


-- ============================================================
-- Question 5: Which demographic groups contribute the
-- largest share of revenue?
-- ============================================================

WITH age_groups AS (
    SELECT
        customer_id,
        purchase_amount_usd,
        CASE
            WHEN age BETWEEN 18 AND 30 THEN 'Young Adults'
            WHEN age BETWEEN 31 AND 45 THEN 'Adults'
            WHEN age BETWEEN 46 AND 60 THEN 'Middle Aged'
            ELSE 'Seniors'
        END AS age_group
    FROM customer_data
)

SELECT
    ag.age_group,
    cd.gender,
    ROUND(SUM(ag.purchase_amount_usd), 2) AS total_revenue
FROM age_groups ag
JOIN customer_data cd
    ON ag.customer_id = cd.customer_id
GROUP BY
    ag.age_group,
    cd.gender
ORDER BY total_revenue DESC;

-- Insight:
-- • Middle-aged male customers generate the highest revenue.
-- • Adult male customers are the second-largest revenue contributors.
-- • Together, these demographic groups account for the largest share of total revenue.